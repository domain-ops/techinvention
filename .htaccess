<IfModule mod_rewrite.c>
  RewriteEngine On

  # 301 Redirects from techinvention.biz to techinvention.com
  RewriteCond %{HTTP_HOST} ^(www\.)?techinvention\.biz$ [NC]
  RewriteRule ^(techinvention/)?disclaimer/?$ https://techinvention.com/disclaimer/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?techinvention\.biz$ [NC]
  RewriteRule ^(techinvention/)?cdmo/?$ https://techinvention.com/cdmo/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?techinvention\.biz$ [NC]
  RewriteRule ^(techinvention/)?rnd/?$ https://techinvention.com/rnd/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?techinvention\.biz$ [NC]
  RewriteRule ^(techinvention/)?terms-and-conditions/?$ https://techinvention.com/terms-and-conditions/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?techinvention\.biz$ [NC]
  RewriteRule ^(techinvention/)?products/?$ https://techinvention.com/products/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?techinvention\.biz$ [NC]
  RewriteRule ^(techinvention/)?contact-us/?$ https://techinvention.com/contact-us/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?techinvention\.biz$ [NC]
  RewriteRule ^(techinvention/)?about/csr-initiatives/?$ https://techinvention.com/about/csr-initiatives/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?techinvention\.biz$ [NC]
  RewriteRule ^(techinvention/)?about/awards-certifications/?$ https://techinvention.com/about/awards-certifications/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?techinvention\.biz$ [NC]
  RewriteRule ^(techinvention/)?about/?$ https://techinvention.com/about/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?techinvention\.biz$ [NC]
  RewriteRule ^(techinvention/)?gmp-training/?$ https://techinvention.com/gmp-training/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?techinvention\.biz$ [NC]
  RewriteRule ^(techinvention/)?careers/?$ https://techinvention.com/careers/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?techinvention\.biz$ [NC]
  RewriteRule ^(techinvention/)?consulting/?$ https://techinvention.com/consulting/ [R=301,L]

  # Catch-all 301 redirect for all other techinvention.biz requests
  RewriteCond %{HTTP_HOST} ^(www\.)?techinvention\.biz$ [NC]
  RewriteRule ^techinvention/(.*)$ https://techinvention.com/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?techinvention\.biz$ [NC]
  RewriteRule ^(.*)$ https://techinvention.com/$1 [R=301,L]

  # Internal rewrite for SPA / Static Export on Hostinger
  RewriteBase /techinvention/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /techinvention/index.html [L]
</IfModule>

# Enable Gzip & Deflate Compression for Hostinger
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE font/ttf
</IfModule>

# Enable Long-Term Browser Caching for Fast Repeat Visits
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# Set Cache-Control Headers
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|avif|css|js|woff2?|ttf|svg)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

