# SMTP Configuration for Website Form Leads
# Email destination and sender settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=clientleadbackup@gmail.com
# For Gmail, create an App Password at https://myaccount.google.com/apppasswords
SMTP_PASS=your-gmail-app-password-here
SMTP_FROM="TechInvention" <clientleadbackup@gmail.com>

# Email Recipient Settings
# Careers form sends to both hr@techinvention.biz and connect@techinvention.biz
SMTP_CAREERS_TO=hr@techinvention.biz, connect@techinvention.biz

# Contact form sends to connect@techinvention.biz
SMTP_CONTACT_TO=connect@techinvention.biz

